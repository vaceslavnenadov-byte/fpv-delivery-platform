# Пример конфигурации backend. Секреты не указываются здесь: используйте переменные *_FILE
# с путём к файлу (права 0640, владелец root, группа службы fpv). См. docs/deployment.md.

FPV_ENVIRONMENT=production                 # production | test | development
FPV_DATABASE_URL_FILE=/etc/fpv/secrets/database_url
# содержимое файла: postgresql+psycopg://fpv_app:<пароль>@db1.dc.fpv.local:5432/fpv?sslmode=verify-full

# --- Доменная аутентификация ---
FPV_DIRECTORY_PROVIDER=ldap               # ldap | static (static — только development/test)
FPV_LDAP_URI=ldaps://dc1.fpv.local
FPV_LDAP_START_TLS=false
FPV_LDAP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
FPV_LDAP_BASE_DN=DC=fpv,DC=local
FPV_LDAP_BIND_DN=CN=svc-fpv-ldap,OU=Service,OU=FPV,DC=fpv,DC=local
FPV_LDAP_BIND_PASSWORD_FILE=/etc/fpv/secrets/ldap_bind_password
FPV_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
FPV_LDAP_ATTR_OBJECT_ID=objectGUID         # FreeIPA: ipaUniqueID
FPV_LDAP_ATTR_DISABLED=userAccountControl  # FreeIPA: nsAccountLock
FPV_LDAP_NESTED_GROUPS=true
FPV_DIRECTORY_REVALIDATE_S=300

# --- Сессии и защита ---
FPV_SESSION_TTL_S=28800
FPV_SESSION_IDLE_S=1800
FPV_COOKIE_SECURE=true
FPV_TRUSTED_PROXIES=127.0.0.1
FPV_LOGIN_RATE_PER_MIN=10
FPV_MUTATION_RATE_PER_MIN=240

# --- Правила заказов ---
FPV_MAX_CARGO_WEIGHT_G=2000
FPV_MAX_CARGO_DIM_MM=400
FPV_MAX_DISTANCE_M=15000
FPV_ALLOWED_CARGO_TYPES=documents,parcel,food,medical_supplies,spare_parts
FPV_SERVICE_AREA=55.55,37.35,55.95,37.90   # lat_min,lon_min,lat_max,lon_max
FPV_NO_FLY_ZONES=Аэродром:55.60:37.40:3000  # имя:lat:lon:радиус_м;...  (заменить официальными данными)
FPV_MIN_BATTERY_PCT=40
FPV_LINK_LOSS_ABORT_S=120
FPV_RECEIPT_TIMEOUT_H=24

# --- Видео и хранилище (ЦОД) ---
FPV_VIDEO_BUFFER_SECONDS=15
FPV_VIDEO_SPOOL_DIR=/var/lib/fpv/video-spool
FPV_VIDEO_RETENTION_DAYS=180
FPV_OBJECT_STORE=filesystem                # filesystem | s3
FPV_OBJECT_STORE_ROOT=/srv/fpv-evidence
# FPV_S3_ENDPOINT=https://minio.dc.fpv.local
# FPV_S3_BUCKET=fpv-evidence
# FPV_S3_ACCESS_KEY_FILE=/etc/fpv/secrets/s3_access_key
# FPV_S3_SECRET_KEY_FILE=/etc/fpv/secrets/s3_secret_key
FPV_TELEMETRY_RETENTION_DAYS=365
FPV_RUN_BACKGROUND_IN_APP=false            # в production воркер — отдельная служба fpv-worker
