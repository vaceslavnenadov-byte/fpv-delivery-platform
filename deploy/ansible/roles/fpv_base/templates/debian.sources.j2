# {{ ansible_managed }}
# Источник: {{ fpv_apt_source }}. Формат deb822 (Debian 13). Целостность пакетов обеспечивается
# проверкой подписи репозитория (debian-archive-keyring), поэтому для официальных зеркал допустим HTTP.
Types: deb
URIs: {{ fpv_apt_mirror_url if fpv_apt_source == 'mirror' else 'http://deb.debian.org/debian' }}
Suites: trixie trixie-updates
Components: main
Signed-By: {{ fpv_apt_signed_by }}

Types: deb
URIs: {{ fpv_apt_mirror_security_url if fpv_apt_source == 'mirror' else 'http://security.debian.org/debian-security' }}
Suites: trixie-security
Components: main
Signed-By: {{ fpv_apt_signed_by }}
