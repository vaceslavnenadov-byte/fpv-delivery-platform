# {{ ansible_managed }}
# Источник: {{ fpv_apt_source }}. Целостность пакетов обеспечивается проверкой подписи
# репозитория (debian-archive-keyring), поэтому для официальных зеркал допустим HTTP.
{% if fpv_apt_source == 'mirror' %}
deb {{ fpv_apt_mirror_url }} bullseye main
deb {{ fpv_apt_mirror_url }} bullseye-updates main
deb {{ fpv_apt_mirror_security_url }} bullseye-security main
{% else %}
deb http://deb.debian.org/debian bullseye main
deb http://deb.debian.org/debian bullseye-updates main
deb http://security.debian.org/debian-security bullseye-security main
{% endif %}
