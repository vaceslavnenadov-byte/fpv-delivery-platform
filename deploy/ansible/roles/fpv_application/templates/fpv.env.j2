# {{ ansible_managed }}
# Секреты не хранятся в этом файле: значения читаются из *_FILE.
FPV_ENVIRONMENT={{ fpv_environment }}
FPV_DATABASE_URL_FILE={{ fpv_config_dir }}/secrets/database_url
FPV_DIRECTORY_PROVIDER=ldap
FPV_LDAP_URI={{ fpv_domain_ldap_uri }}
FPV_LDAP_BASE_DN={{ fpv_domain_ou | regex_replace('^.*?(DC=.*)$', '\\1') }}
FPV_LDAP_BIND_DN={{ fpv_app_ldap_bind_dn }}
FPV_LDAP_BIND_PASSWORD_FILE={{ fpv_config_dir }}/secrets/ldap_bind_password
FPV_LDAP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
FPV_COOKIE_SECURE=true
FPV_TRUSTED_PROXIES=127.0.0.1
FPV_VIDEO_SPOOL_DIR={{ fpv_app_video_spool_dir }}
FPV_VIDEO_RETENTION_DAYS={{ fpv_app_video_retention_days }}
FPV_OBJECT_STORE={{ fpv_app_object_store }}
FPV_OBJECT_STORE_ROOT={{ fpv_app_object_store_root }}
FPV_RUN_BACKGROUND_IN_APP=false
