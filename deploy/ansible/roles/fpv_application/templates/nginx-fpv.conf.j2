# {{ ansible_managed }}
limit_req_zone $binary_remote_addr zone=fpv_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=fpv_api:10m rate=30r/s;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Запросы с неизвестным Host отбрасываются: приложение получает только проверенное имя
# (защита от подмены Host при восстановлении URL, см. docs/security-review.md).
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name {{ fpv_app_server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ fpv_app_server_name }};
    ssl_certificate {{ fpv_app_tls_cert }};
    ssl_certificate_key {{ fpv_app_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss:; style-src 'self' 'unsafe-inline'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    server_tokens off;
    client_max_body_size 10m;

    root {{ fpv_install_root }}/current/frontend/dist;
    # Общий вход и отдельные клиенты по ролям (каждый — свой index.html, SPA-переходы внутри).
    location = / { try_files /index.html =404; }
    location /customer/    { try_files $uri $uri/ /customer/index.html; }
    location /operator/    { try_files $uri $uri/ /operator/index.html; }
    location /coordinator/ { try_files $uri $uri/ /coordinator/index.html; }
    location /technician/  { try_files $uri $uri/ /technician/index.html; }
    location /recruiter/   { try_files $uri $uri/ /recruiter/index.html; }
    location /admin/       { try_files $uri $uri/ /admin/index.html; }
    location / { try_files $uri /index.html; }

    location = /api/v1/auth/login {
        limit_req zone=fpv_login burst=5 nodelay;
        proxy_pass http://{{ fpv_app_listen }};
        include /etc/nginx/proxy_params;
    }
    # Загрузка карт-подложек: изображения крупнее общего ограничения тела запроса.
    location = /api/v1/admin/maps {
        limit_req zone=fpv_api burst=10 nodelay;
        client_max_body_size 60m;
        proxy_pass http://{{ fpv_app_listen }};
        include /etc/nginx/proxy_params;
        proxy_request_buffering off;
    }
    # ^~ обязателен: иначе запрос перехватит regex-блок /api/ ниже (без Upgrade → 404)
    location ^~ /api/v1/ws {
        proxy_pass http://{{ fpv_app_listen }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
    location ~ ^/(api|drone-link|health)/ {
        limit_req zone=fpv_api burst=60 nodelay;
        proxy_pass http://{{ fpv_app_listen }};
        include /etc/nginx/proxy_params;
        proxy_request_buffering off;
    }
}
