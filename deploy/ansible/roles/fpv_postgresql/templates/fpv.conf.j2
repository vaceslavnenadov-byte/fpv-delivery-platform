# {{ ansible_managed }}
listen_addresses = '{{ fpv_postgresql_listen }}'
port = {{ fpv_postgresql_port }}
password_encryption = scram-sha-256
ssl = {{ 'on' if fpv_postgresql_ssl else 'off' }}
ssl_min_protocol_version = 'TLSv1.2'
log_connections = on
log_disconnections = on
log_line_prefix = '%m [%p] %q%u@%d %r '
log_statement = 'ddl'
log_min_duration_statement = 1000
