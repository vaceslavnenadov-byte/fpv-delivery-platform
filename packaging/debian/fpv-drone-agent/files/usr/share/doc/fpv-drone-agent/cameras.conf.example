# RTSP-камеры дрона: по одной на строку, ИМЯ=rtsp://адрес
# Имя — латинские буквы, цифры, точка, дефис, подчёркивание. Оператор видит только имя;
# адрес (в том числе логин и пароль) остаётся на сервисном модуле.
# После изменения: systemctl restart fpv-agent (или подождать до 30 с).
#
# nose=rtsp://user:password@192.168.1.10:554/stream1
# belly=rtsp://192.168.1.11/live
