# Параметры сервисного модуля дрона.
FPV_AGENT_SERVER=https://fpv.dc.fpv.local
# Сценарий симулятора: normal | fast | link-loss | link-blip | critical-error | no-video | faulty
FPV_AGENT_SCENARIO=normal
FPV_DRONE_KEY_FILE=/etc/fpv-agent/key
# Сертификат УЦ для проверки сервера (пусто — системное хранилище)
FPV_AGENT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Видео дрона. Источник по умолчанию: /dev/videoN; пусто — тестовая таблица.
# Оператор может выбрать другой источник в мониторе полёта (кнопка ⚙): USB-камеры,
# RTSP-камеры из /etc/fpv-agent/cameras.conf, тестовые ролики из FPV_AGENT_VIDEO_DIR.
FPV_AGENT_VIDEO_DEVICE=
FPV_AGENT_VIDEO_DIR=/var/lib/fpv-agent/videos
FPV_AGENT_VIDEO_SIZE=640x480
FPV_AGENT_VIDEO_FPS=15
