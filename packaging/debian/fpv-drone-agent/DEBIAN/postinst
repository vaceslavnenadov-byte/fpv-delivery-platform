#!/bin/sh
set -e
case "$1" in
configure)
    getent group fpv-agent >/dev/null || groupadd --system fpv-agent
    getent passwd fpv-agent >/dev/null || useradd --system --gid fpv-agent --home-dir /var/lib/fpv-agent \
        --no-create-home --shell /usr/sbin/nologin --comment "FPV drone service module" fpv-agent
    [ -d /var/lib/fpv-agent ] || install -d -o fpv-agent -g fpv-agent -m 0750 /var/lib/fpv-agent
    install -d -o root -g fpv-agent -m 0750 /etc/fpv-agent
    # RTSP-камеры дрона (адреса могут содержать пароли — файл читает только служба)
    if [ ! -e /etc/fpv-agent/cameras.conf ]; then
        install -o root -g fpv-agent -m 0640 /usr/share/doc/fpv-drone-agent/cameras.conf.example /etc/fpv-agent/cameras.conf
    fi
    # Папка тестовых роликов; если пуста и есть ffmpeg — создаётся пример (20 с)
    install -d -o root -g fpv-agent -m 0755 /var/lib/fpv-agent/videos
    if [ -z "$(ls -A /var/lib/fpv-agent/videos 2>/dev/null)" ] && command -v ffmpeg >/dev/null 2>&1; then
        ffmpeg -nostdin -loglevel error -f lavfi -i testsrc2=size=640x480:rate=15 -t 20 -c:v mpeg4 -q:v 5 \
            /var/lib/fpv-agent/videos/example-test.mp4 || rm -f /var/lib/fpv-agent/videos/example-test.mp4
        [ -e /var/lib/fpv-agent/videos/example-test.mp4 ] && chmod 0644 /var/lib/fpv-agent/videos/example-test.mp4
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        systemctl enable fpv-agent.service >/dev/null
        if [ -s /etc/fpv-agent/key ]; then
            systemctl restart fpv-agent.service
        else
            echo "fpv-drone-agent: запишите ключ устройства в /etc/fpv-agent/key (владелец fpv-agent, права 0600)"
            echo "  и адрес сервера в /etc/default/fpv-agent, затем: systemctl start fpv-agent"
        fi
    fi
    ;;
esac
exit 0
