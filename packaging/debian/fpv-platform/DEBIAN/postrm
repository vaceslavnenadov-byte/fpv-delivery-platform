#!/bin/sh
# Данные (БД, видеоподтверждения, журналы), секреты и учётная запись службы НЕ удаляются:
# это доказательная база и история заказов. Удалите их вручную, если это действительно нужно.
set -e
case "$1" in
remove|purge)
    rm -rf /usr/lib/fpv-platform/venv
    if [ -d /run/systemd/system ]; then
        systemctl disable fpv-api.service fpv-worker.service >/dev/null 2>&1 || true
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    ;;
esac
if [ "$1" = "purge" ]; then
    echo "fpv-platform: сохранены /etc/fpv/secrets, /var/lib/fpv, /var/log/fpv, /srv/fpv-evidence и пользователь fpv."
fi
exit 0
