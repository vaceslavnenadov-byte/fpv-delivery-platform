# Конфигурация fpv-platform (пакет Debian). Секреты сюда не записываются:
# используются файлы /etc/fpv/secrets/* (root:fpv, 0640) через переменные *_FILE.
# Полный перечень параметров — /usr/share/doc/fpv-platform/env.example

FPV_ENVIRONMENT=production
FPV_DATABASE_URL_FILE=/etc/fpv/secrets/database_url
# содержимое: postgresql+psycopg://fpv_app:<пароль>@db1.dc.fpv.local:5432/fpv?sslmode=verify-full

FPV_DIRECTORY_PROVIDER=ldap
FPV_LDAP_URI=ldaps://dc1.fpv.local
FPV_LDAP_BASE_DN=DC=fpv,DC=local
FPV_LDAP_BIND_DN=CN=svc-fpv-ldap,OU=Service,OU=FPV,DC=fpv,DC=local
FPV_LDAP_BIND_PASSWORD_FILE=/etc/fpv/secrets/ldap_bind_password
FPV_LDAP_CA_FILE=/etc/ssl/certs/ca-certificates.crt

FPV_COOKIE_SECURE=true
FPV_TRUSTED_PROXIES=127.0.0.1
FPV_VIDEO_SPOOL_DIR=/var/lib/fpv/video-spool
FPV_OBJECT_STORE=filesystem
FPV_OBJECT_STORE_ROOT=/srv/fpv-evidence
FPV_RUN_BACKGROUND_IN_APP=false
